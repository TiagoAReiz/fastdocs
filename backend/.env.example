PROJECT_NAME=FastDocs

# Postgres
POSTGRES_USER=fastdocs
POSTGRES_PASSWORD=fastdocs
POSTGRES_DB=fastdocs
DATABASE_URL=postgresql+asyncpg://fastdocs:fastdocs@postgres:5432/fastdocs

# Redis
REDIS_URL=redis://redis:6379/0

# Azure Blob Storage (Azurite local — well-known public emulator key, not a real credential)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
AZURE_STORAGE_CONTAINER=documents

# Admin auth (service-to-service)
# Generate SERVICE_API_KEY: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SERVICE_API_KEY=your-service-api-key-here

# IPs or CIDRs allowed to call /admin/* (JSON list or comma-separated).
# Matched against the TCP peer address, NOT against X-Forwarded-For.
# Empty = /admin/* denied for everyone. Any invalid entry = /admin/* denied (fail closed).
# Under docker compose, requests from the host arrive from the bridge gateway
# (e.g. 172.18.0.1), so add it or its range: ["127.0.0.1","::1","172.16.0.0/12"]
ADMIN_ALLOWED_IPS=["127.0.0.1","::1"]

# Reverse proxies (IPs or CIDRs) whose X-Forwarded-For header is trusted.
# Leave empty unless the API sits behind a proxy/load balancer you control.
# When the TCP peer is in this list, the client IP is the right-most
# X-Forwarded-For entry that is not itself a trusted proxy.
TRUSTED_PROXIES=[]
ENCRYPTION_KEY=your-fernet-key-here
